# Cổng chạy website khi dev
PORT=5000

# Địa chỉ API (BE-an-tour)
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Tùy chọn: ID website trên Crisp (khung chat)
NUXT_PUBLIC_CRISP_WEBSITE_ID=

# Secret dùng chung với API, phải trùng API_PROXY_SECRET của BE-an-tour. Chỉ dùng ở server, không lộ ra trình duyệt.
# Server Nuxt gửi kèm IP thật của khách để API giới hạn tần suất riêng từng khách.
# IP lấy từ X-Forwarded-For: chạy sau proxy ghi đè header này (Vercel đã làm sẵn) để khách không tự khai IP được.
# Bỏ trống thì mọi khách dùng chung hạn mức của server Nuxt và dễ gặp lỗi 429 Too Many Requests.
NUXT_API_PROXY_SECRET=
